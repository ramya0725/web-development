
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>To-Do App</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --brand:#6c5ce7;
    --brand-dark:#5849c2;
    --bg:#f4f3fb;
  }
  body{
    font-family:'Poppins', sans-serif;
    background:linear-gradient(135deg,#eef1ff 0%,#f4f3fb 60%,#fff 100%);
    min-height:100vh;
  }
  .app-card{
    max-width:520px;
    margin:60px auto;
    border:none;
    border-radius:18px;
    box-shadow:0 15px 35px rgba(108,92,231,0.15);
    overflow:hidden;
  }
  .app-header{
    background:linear-gradient(135deg,var(--brand),var(--brand-dark));
    color:#fff;
    padding:28px 30px;
  }
  .app-header h1{
    font-size:1.6rem;
    font-weight:700;
    margin:0;
  }
  .app-header p{
    margin:4px 0 0;
    opacity:.85;
    font-size:.9rem;
  }
  .app-body{
    padding:24px 26px 30px;
    background:#fff;
  }
  #taskInput:focus{
    box-shadow:0 0 0 .2rem rgba(108,92,231,.2);
    border-color:var(--brand);
  }
  .btn-brand{
    background:var(--brand);
    border-color:var(--brand);
    color:#fff;
  }
  .btn-brand:hover{
    background:var(--brand-dark);
    border-color:var(--brand-dark);
    color:#fff;
  }
  .list-group-item{
    border:none;
    border-radius:10px !important;
    margin-bottom:8px;
    background:#f8f8ff;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 14px;
    transition:background .2s;
  }
  .list-group-item:hover{background:#f0eefe;}
  .task-text{
    flex:1;
    margin-left:10px;
    word-break:break-word;
  }
  .task-text.done{
    text-decoration:line-through;
    color:#9a9a9a;
  }
  .task-left{
    display:flex;
    align-items:center;
    flex:1;
    min-width:0;
  }
  .form-check-input:checked{
    background-color:var(--brand);
    border-color:var(--brand);
  }
  .delete-btn{
    color:#ff6b6b;
    border:none;
    background:none;
    font-size:1.1rem;
    line-height:1;
    padding:4px 8px;
  }
  .delete-btn:hover{color:#e63946;}
  .filter-btn.active{
    background:var(--brand);
    color:#fff;
    border-color:var(--brand);
  }
  .empty-state{
    text-align:center;
    color:#aaa;
    padding:30px 0;
    font-size:.95rem;
  }
  .stats{
    font-size:.85rem;
    color:#888;
  }
</style>
</head>
<body>

<div class="app-card card">
  <div class="app-header">
    <h1>✅ My To-Do List</h1>
    <p>Stay organized, one task at a time.</p>
  </div>

  <div class="app-body">
    <!-- Add task -->
    <div class="input-group mb-3">
      <input type="text" id="taskInput" class="form-control" placeholder="What do you need to do?" maxlength="120">
      <button class="btn btn-brand" id="addBtn">Add</button>
    </div>

    <!-- Filters -->
    <div class="btn-group w-100 mb-3" role="group">
      <button class="btn btn-outline-secondary btn-sm filter-btn active" data-filter="all">All</button>
      <button class="btn btn-outline-secondary btn-sm filter-btn" data-filter="active">Active</button>
      <button class="btn btn-outline-secondary btn-sm filter-btn" data-filter="completed">Completed</button>
    </div>

    <!-- Task list -->
    <ul class="list-group" id="taskList"></ul>
    <div class="empty-state d-none" id="emptyState">No tasks here yet 🎉</div>

    <!-- Footer -->
    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
      <span class="stats" id="statsText">0 tasks</span>
      <button class="btn btn-sm btn-outline-danger" id="clearCompletedBtn">Clear Completed</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ---- State ----
  let tasks = []; // {id, text, done}
  let currentFilter = 'all';

  const taskInput = document.getElementById('taskInput');
  const addBtn = document.getElementById('addBtn');
  const taskList = document.getElementById('taskList');
  const emptyState = document.getElementById('emptyState');
  const statsText = document.getElementById('statsText');
  const clearCompletedBtn = document.getElementById('clearCompletedBtn');
  const filterBtns = document.querySelectorAll('.filter-btn');

  // ---- Add task ----
  function addTask() {
    const text = taskInput.value.trim();
    if (!text) return;
    tasks.push({ id: Date.now(), text, done: false });
    taskInput.value = '';
    render();
  }

  addBtn.addEventListener('click', addTask);
  taskInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') addTask();
  });

  // ---- Toggle / Delete ----
  function toggleTask(id) {
    tasks = tasks.map(t => t.id === id ? { ...t, done: !t.done } : t);
    render();
  }

  function deleteTask(id) {
    tasks = tasks.filter(t => t.id !== id);
    render();
  }

  clearCompletedBtn.addEventListener('click', () => {
    tasks = tasks.filter(t => !t.done);
    render();
  });

  // ---- Filters ----
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      render();
    });
  });

  // ---- Render ----
  function render() {
    let visibleTasks = tasks;
    if (currentFilter === 'active') visibleTasks = tasks.filter(t => !t.done);
    if (currentFilter === 'completed') visibleTasks = tasks.filter(t => t.done);

    taskList.innerHTML = '';

    if (visibleTasks.length === 0) {
      emptyState.classList.remove('d-none');
    } else {
      emptyState.classList.add('d-none');
    }

    visibleTasks.forEach(task => {
      const li = document.createElement('li');
      li.className = 'list-group-item';
      li.innerHTML = `
        <div class="task-left">
          <input type="checkbox" class="form-check-input" ${task.done ? 'checked' : ''}>
          <span class="task-text ${task.done ? 'done' : ''}">${escapeHtml(task.text)}</span>
        </div>
        <button class="delete-btn" title="Delete task">✕</button>
      `;
      li.querySelector('.form-check-input').addEventListener('change', () => toggleTask(task.id));
      li.querySelector('.delete-btn').addEventListener('click', () => deleteTask(task.id));
      taskList.appendChild(li);
    });

    const remaining = tasks.filter(t => !t.done).length;
    statsText.textContent = `${remaining} of ${tasks.length} task${tasks.length !== 1 ? 's' : ''} remaining`;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  render();
</script>
</body>
</html>
