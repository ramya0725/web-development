
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculator</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-dark:#1b1c2b;
    --panel:#252740;
    --accent:#ff9f43;
    --accent-dark:#e8873b;
    --op:#3d3f63;
  }
  body{
    font-family:'Poppins', sans-serif;
    background:radial-gradient(circle at top, #2a2c47, #14151f 70%);
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0;
  }
  .calc-card{
    width:340px;
    background:var(--panel);
    border-radius:22px;
    padding:22px;
    box-shadow:0 20px 50px rgba(0,0,0,0.45);
  }
  .calc-title{
    color:#8f92c0;
    font-size:.8rem;
    letter-spacing:1px;
    text-transform:uppercase;
    margin-bottom:10px;
    text-align:center;
  }
  .display{
    background:#14151f;
    border-radius:14px;
    padding:20px 18px;
    text-align:right;
    margin-bottom:18px;
    min-height:96px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    overflow:hidden;
  }
  .prev-operand{
    color:#7c7fa6;
    font-family:'Roboto Mono', monospace;
    font-size:.95rem;
    min-height:20px;
    word-break:break-all;
  }
  .current-operand{
    color:#fff;
    font-family:'Roboto Mono', monospace;
    font-size:2.1rem;
    font-weight:700;
    word-break:break-all;
  }
  .btn-calc{
    width:100%;
    height:60px;
    border-radius:14px;
    border:none;
    font-size:1.2rem;
    font-weight:600;
    color:#fff;
    background:var(--op);
    transition:transform .08s ease, background .2s;
  }
  .btn-calc:active{transform:scale(0.94);}
  .btn-num{background:#31335a;}
  .btn-num:hover{background:#3a3d6b;}
  .btn-op{background:var(--accent); color:#1b1c2b;}
  .btn-op:hover{background:var(--accent-dark);}
  .btn-clear{background:#ff5e5e;}
  .btn-clear:hover{background:#e34f4f;}
  .btn-equals{
    background:var(--accent);
    color:#1b1c2b;
    grid-column:span 2;
  }
  .btn-equals:hover{background:var(--accent-dark);}
  .grid-calc{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:10px;
  }
</style>
</head>
<body>

<div class="calc-card">
  <div class="calc-title">Calculator</div>
  <div class="display">
    <div class="prev-operand" id="prevOperand">&nbsp;</div>
    <div class="current-operand" id="currentOperand">0</div>
  </div>

  <div class="grid-calc">
    <button class="btn-calc btn-clear" data-action="clear">AC</button>
    <button class="btn-calc btn-op" data-action="delete">DEL</button>
    <button class="btn-calc btn-op" data-op="%">%</button>
    <button class="btn-calc btn-op" data-op="÷">÷</button>

    <button class="btn-calc btn-num" data-num="7">7</button>
    <button class="btn-calc btn-num" data-num="8">8</button>
    <button class="btn-calc btn-num" data-num="9">9</button>
    <button class="btn-calc btn-op" data-op="×">×</button>

    <button class="btn-calc btn-num" data-num="4">4</button>
    <button class="btn-calc btn-num" data-num="5">5</button>
    <button class="btn-calc btn-num" data-num="6">6</button>
    <button class="btn-calc btn-op" data-op="−">−</button>

    <button class="btn-calc btn-num" data-num="1">1</button>
    <button class="btn-calc btn-num" data-num="2">2</button>
    <button class="btn-calc btn-num" data-num="3">3</button>
    <button class="btn-calc btn-op" data-op="+">+</button>

    <button class="btn-calc btn-num" data-num="0" style="grid-column:span 2;">0</button>
    <button class="btn-calc btn-num" data-num=".">.</button>
    <button class="btn-calc btn-equals" data-action="equals">=</button>
  </div>
</div>

<script>
  const prevOperandEl = document.getElementById('prevOperand');
  const currentOperandEl = document.getElementById('currentOperand');

  let currentOperand = '0';
  let previousOperand = '';
  let operation = undefined;
  let resetNext = false;

  function updateDisplay() {
    currentOperandEl.textContent = currentOperand;
    prevOperandEl.textContent = previousOperand
      ? `${previousOperand} ${operation || ''}`
      : '\u00A0';
  }

  function appendNumber(num) {
    if (currentOperand === '0' || resetNext) {
      currentOperand = '';
      resetNext = false;
    }
    if (num === '.' && currentOperand.includes('.')) return;
    currentOperand += num;
  }

  function chooseOperation(op) {
    if (currentOperand === '') return;
    if (previousOperand !== '') {
      compute();
    }
    operation = op;
    previousOperand = currentOperand;
    resetNext = true;
  }

  function compute() {
    let result;
    const prev = parseFloat(previousOperand);
    const curr = parseFloat(currentOperand);
    if (isNaN(prev) || isNaN(curr)) return;

    switch (operation) {
      case '+': result = prev + curr; break;
      case '−': result = prev - curr; break;
      case '×': result = prev * curr; break;
      case '÷': result = curr === 0 ? 'Error' : prev / curr; break;
      case '%': result = prev % curr; break;
      default: return;
    }

    currentOperand = result === 'Error' ? 'Error' : roundResult(result).toString();
    operation = undefined;
    previousOperand = '';
    resetNext = true;
  }

  function roundResult(num) {
    return Math.round((num + Number.EPSILON) * 1e8) / 1e8;
  }

  function clearAll() {
    currentOperand = '0';
    previousOperand = '';
    operation = undefined;
    resetNext = false;
  }

  function deleteLast() {
    if (resetNext) return;
    currentOperand = currentOperand.slice(0, -1);
    if (currentOperand === '' || currentOperand === '-') currentOperand = '0';
  }

  document.querySelectorAll('[data-num]').forEach(btn => {
    btn.addEventListener('click', () => {
      appendNumber(btn.dataset.num);
      updateDisplay();
    });
  });

  document.querySelectorAll('[data-op]').forEach(btn => {
    btn.addEventListener('click', () => {
      chooseOperation(btn.dataset.op);
      updateDisplay();
    });
  });

  document.querySelector('[data-action="clear"]').addEventListener('click', () => {
    clearAll();
    updateDisplay();
  });

  document.querySelector('[data-action="delete"]').addEventListener('click', () => {
    deleteLast();
    updateDisplay();
  });

  document.querySelector('[data-action="equals"]').addEventListener('click', () => {
    compute();
    updateDisplay();
  });

  // Keyboard support
  window.addEventListener('keydown', (e) => {
    if (/[0-9.]/.test(e.key)) { appendNumber(e.key); updateDisplay(); }
    else if (e.key === '+') { chooseOperation('+'); updateDisplay(); }
    else if (e.key === '-') { chooseOperation('−'); updateDisplay(); }
    else if (e.key === '*') { chooseOperation('×'); updateDisplay(); }
    else if (e.key === '/') { e.preventDefault(); chooseOperation('÷'); updateDisplay(); }
    else if (e.key === 'Enter' || e.key === '=') { compute(); updateDisplay(); }
    else if (e.key === 'Backspace') { deleteLast(); updateDisplay(); }
    else if (e.key === 'Escape') { clearAll(); updateDisplay(); }
  });

  updateDisplay();
</script>
</body>
</html>
